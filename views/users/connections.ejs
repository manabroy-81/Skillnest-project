<% layout("layouts/boilerplate.ejs") %>
<main class="container py-5" style="max-width: 720px">
  <a href="/users/<%= profileUser._id %>" class="text-decoration-none">← Back to profile</a>
  <h1 class="h3 mt-3"><%= profileUser.fullName || profileUser.username %>'s <%= type %></h1>
  <section class="card shadow-sm mt-3">
    <% for (const user of users) { %>
      <div class="card-body border-bottom d-flex align-items-center gap-3">
        <% if (user.profileImage) { %>
          <img src="<%= user.profileImage %>" class="rounded-circle" width="48" height="48" alt="Profile image" />
          <% } %>
        <div class="flex-grow-1">
          <a class="fw-semibold text-decoration-none" href="/users/<%= user._id %>"><%= user.fullName || user.username %>
          </a>
          <small class="d-block text-muted">@<%= user.username %>
          </small>
        </div>
        <% if (currentUser && !currentUser._id.equals(user._id)) { %>
          <form action="/users/<%= user._id %>/follow" method="POST">
            <button class="btn btn-sm btn-outline-primary"><%= currentUser.following.some((id) => id.equals(user._id)) ? "Unfollow" : "Follow" %>
            </button>
          </form>
          <% } %>
      </div>
    <% } %>
    <% if (!users.length) { %><div class="card-body text-muted">No <%= type %> yet.</div><% } %>
  </section>
</main>
