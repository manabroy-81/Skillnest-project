<% layout("layouts/boilerplate.ejs") %>
<main class="container py-5" style="max-width: 460px">
  <h1 class="h3 mb-4">Create your SkillNest account</h1>
  <form
    action="/auth/register"
    method="POST"
    class="card card-body shadow-sm needs-validation"
    novalidate
  >
    <label class="form-label" for="username">Username</label
    ><input
      class="form-control mb-3"
      id="username"
      name="user[username]"
      minlength="3"
      maxlength="30"
      required
    />
    <label class="form-label" for="email">Email</label
    ><input
      class="form-control mb-3"
      id="email"
      name="user[email]"
      type="email"
      required
    />
    <div class="invalid-feedback">Please enter valid Email.</div>

    <label class="form-label" for="password">Password</label>
    <div class="input-group mb-4">
      <input
        class="form-control"
        id="password"
        name="user[password]"
        type="password"
        minlength="8"
        required
      />
      <div class="invalid-feedback">Please enter minimum 8 characters.</div>
      <button
        class="btn btn-outline-secondary"
        type="button"
        data-password-toggle="#password"
        aria-label="Show password"
        aria-pressed="false"
      >
        <i class="fa-regular fa-eye" aria-hidden="true"></i>
      </button>
    </div>
    <button class="btn btn-primary">Create account</button>
  </form>
  <p class="mt-3">Already a member? <a href="/auth/login">Log in</a>.</p>
</main>
